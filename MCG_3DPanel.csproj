<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ============================================================
         .NET 8 (net8.0-windows) — BẮT BUỘC cho AutoCAD 2026.
         API managed AutoCAD 2026 (AcMgd/AcDbMgd/AcCoreMgd) = .NETCoreApp v8.0;
         plugin net48 KHÔNG NETLOAD được. Bản .NET 8 chỉ chạy AutoCAD 2025+.
         ============================================================ -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MCG_3DPanel</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>

    <!-- Sinh .deps.json + copy dependency ra output (AutoCAD 2025+ nạp plugin
         trong AssemblyLoadContext riêng). -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RollForward>LatestMinor</RollForward>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>portable</DebugType>
    <!-- Plugin AutoCAD luôn chạy Windows — tắt cảnh báo platform-compat. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- MSB3277: AcDbMgdBrep/AcTcMgd của AutoCAD 2026 kéo Microsoft.VisualBasic 10.1
         và System.Drawing bản cũ — vô hại (AutoCAD tự cấp lúc runtime, Private=False). -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>

    <!-- Đổi để build cho AutoCAD khác (2025+). -->
    <AcadYear>2026</AcadYear>
    <AcadPath>C:\Program Files\Autodesk\AutoCAD $(AcadYear)</AcadPath>
  </PropertyGroup>

  <!-- Debug: DLL kèm timestamp => NETLOAD nạp lại được mà KHÔNG cần restart AutoCAD.
       BuildStamp PHẢI truyền từ dòng lệnh (deploy.bat: -p:BuildStamp=...): WPF dựng thêm project tạm
       *_wpftmp và ĐÁNH GIÁ LẠI csproj; nếu tự lấy DateTime.Now thì 2 lần đánh giá có thể lệch 1 giây
       → URI XAML trỏ tới assembly không tồn tại → MCG_Build3DPanel crash 0xC0000005 (2026-11-10:
       DLL _100422 chứa "/MCG_3DPanel_..._100423;component/UI/PanelInputView.xaml").
       Thuộc tính global từ dòng lệnh truyền nguyên sang project tạm nên 2 lần trùng nhau.
       Fallback Now chỉ cho build tay (dotnet build không tham số) — vẫn có thể lệch, dùng deploy.bat.
       Build nền của IDE (DesignTimeBuild) dùng tên CỐ ĐỊNH: nếu lấy Now, mỗi lần đánh giá ra tên mới →
       IDE ghi lại obj\Debug\UI\*.g.cs → tự kích hoạt lần đánh giá kế (vòng lặp ~1,5 giây, đã sinh 151.878
       file *_MarkupCompile.cache) và ghi đè .g.cs ngay giữa lúc deploy.bat đang build. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <BuildStamp Condition="'$(BuildStamp)' == '' and '$(DesignTimeBuild)' == 'true'">design</BuildStamp>
    <!-- Build nền của IDE ghi file trung gian ra obj\Design\, không đụng obj\Debug\ của deploy.bat. -->
    <IntermediateOutputPath Condition="'$(DesignTimeBuild)' == 'true'">$(BaseIntermediateOutputPath)Design\</IntermediateOutputPath>
    <BuildStamp Condition="'$(BuildStamp)' == ''">$([System.DateTime]::Now.ToString('yyyyMMdd_HHmmss'))</BuildStamp>
    <AssemblyName>MCG_3DPanel_$(BuildStamp)</AssemblyName>
  </PropertyGroup>
  <!-- Release: tên ổn định cho bundle autoload. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AssemblyName>MCG_3DPanel</AssemblyName>
  </PropertyGroup>

  <!-- Chặn DLL hỏng: mọi XAML sinh code (*.g.cs có ";component/") phải trỏ đúng AssemblyName của
       lần build này. Lệch (IDE ghi đè giữa chừng) ⇒ build FAIL thay vì ra DLL làm AutoCAD crash. -->
  <Target Name="CheckXamlAssemblyName" BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true' and !$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <ItemGroup>
      <!-- Chỉ file đang được biên dịch (@(Compile)), không quét obj: .g.cs của XAML đã xoá vẫn nằm lại đó. -->
      <_XamlGen Include="@(Compile)" Condition="$([System.String]::Copy('%(Filename)%(Extension)').EndsWith('.g.cs'))" />
      <_XamlBad Include="@(_XamlGen)"
                Condition="$([System.IO.File]::ReadAllText('%(FullPath)').Contains(';component/')) and !$([System.IO.File]::ReadAllText('%(FullPath)').Contains('/$(AssemblyName);'))" />
    </ItemGroup>
    <Error Condition="'@(_XamlBad)' != ''"
           Text="XAML generated code does not match assembly '$(AssemblyName)' (overwritten by another build, e.g. the IDE): @(_XamlBad->'%(Filename)%(Extension)'). Build again with deploy.bat." />
  </Target>

  <!-- Release: deploy NGUYÊN thư mục output + PackageContents.xml vào
       C:\CustomTools\Autocad\MCG_3DPanel\. -->
  <Target Name="DeployToCustomTools" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_Deploy Include="$(OutputPath)**\*" />
      <_Deploy Include="$(ProjectDir)PackageContents.xml" />
    </ItemGroup>
    <RemoveDir Directories="C:\CustomTools\Autocad\MCG_3DPanel" />
    <MakeDir Directories="C:\CustomTools\Autocad\MCG_3DPanel" />
    <Copy SourceFiles="@(_Deploy)"
          DestinationFiles="@(_Deploy-&gt;'C:\CustomTools\Autocad\MCG_3DPanel\%(RecursiveDir)%(Filename)%(Extension)')"
          ContinueOnError="true" />
    <Message Text="[Deploy] MCG_3DPanel (net8, full folder) → C:\CustomTools\Autocad\MCG_3DPanel" Importance="High" />
  </Target>

  <!-- Test project (tests/) là project riêng — không biên dịch vào plugin. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <!-- Tham chiếu AutoCAD 2026 .NET API. Private=false => KHÔNG copy vào bin -->
  <ItemGroup>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AcadPath)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AcadPath)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcMgd">
      <HintPath>$(AcadPath)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgdBrep">
      <HintPath>$(AcadPath)\AcDbMgdBrep.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
