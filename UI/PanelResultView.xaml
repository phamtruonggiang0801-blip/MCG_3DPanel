<UserControl x:Class="MCG_3DPanel.UI.PanelResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFF2F2F2"
             FontSize="11">
    <!-- Tab "Result" của PaletteSet. Bố cục theo tab Fitting Table: thanh công cụ → bảng → trạng thái.
         Cột theo họ kết cấu (spec 2026-11-04): Family · Kind (dropdown) · Size · Dir (⇄) · Flags. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PanelStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Dòng có correction → chữ XANH SemiBold, như dòng user chủ động sửa bên Fitting. -->
            <Style x:Key="ResultRowStyle" TargetType="DataGridRow">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCorrected}" Value="True">
                        <Setter Property="Foreground" Value="#FF0050C8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                    <!-- Sửa trên bản 2D đang chờ Update: nền vàng nhạt + tooltip. -->
                    <DataTrigger Binding="{Binding Pending}" Value="True">
                        <Setter Property="Background" Value="#FFFFF2CC"/>
                        <Setter Property="ToolTip" Value="Waiting for Update"/>
                    </DataTrigger>
                    <!-- Solid đã Delete: xám nghiêng (chuột phải → Restore). Đặt SAU để thắng màu xanh. -->
                    <DataTrigger Binding="{Binding Deleted}" Value="True">
                        <Setter Property="Foreground" Value="#FF9A9A9A"/>
                        <Setter Property="FontStyle" Value="Italic"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: thanh công cụ -->
            <RowDefinition Height="Auto"/>   <!-- 1: hướng dẫn -->
            <RowDefinition Height="*" MinHeight="80"/>
            <RowDefinition Height="Auto"/>   <!-- 3: trạng thái -->
        </Grid.RowDefinitions>

        <!-- ===== Row 0: Thanh công cụ ===== -->
        <WrapPanel Grid.Row="0" Margin="1,0,1,2">
            <Button x:Name="BtnExportMenu" Content="Export ▾" Style="{StaticResource ToolbarPrimaryButtonStyle}"
                    Click="BtnExportMenu_Click" ToolTip="Export the table to CSV, or each panel to STEP">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="MnuExportCsv" Header="CSV table" Click="BtnExport_Click"
                                  ToolTip="Export the table (incl. corrections) to a CSV file"/>
                        <MenuItem x:Name="MnuExportStep" Header="STEP files (one per panel)" Click="BtnStep_Click"
                                  ToolTipService.ShowOnDisabled="True"
                                  ToolTip="Export each panel to its own STEP file (&lt;Panel&gt;.stp)"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <!-- Create Drawing (spec 2026-11-10): ghi Plan View vào bản vẽ 2D đã dựng ra panel. -->
            <Button x:Name="BtnCreateDrawing" Content="Create Drawing ▾" Style="{StaticResource ToolbarPrimaryButtonStyle}"
                    Click="BtnCreateDrawing_Click" ToolTip="Write names, symbols, dimensions and sections into the 2D drawing">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="MnuPlanView" Header="Plan View" Click="MnuPlanView_Click"
                                  ToolTipService.ShowOnDisabled="True"
                                  ToolTip="Write the Plan View sheet of this panel into the 2D drawing it was built from"/>
                        <Separator/>
                        <MenuItem x:Name="MnuDetailPlan" Header="Detail Plan" Click="MnuDetailPlan_Click"
                                  ToolTipService.ShowOnDisabled="True"
                                  ToolTip="Cut a detail (inserted at scale 1) from an AM_7 rectangle on the Plan View"/>
                        <MenuItem x:Name="MnuSectionDetail" Header="Section Detail" Click="MnuSectionDetail_Click"
                                  ToolTipService.ShowOnDisabled="True"
                                  ToolTip="Cut a section through a Detail Plan"/>
                        <MenuItem x:Name="MnuDetailView" Header="Detail View" Click="MnuDetailView_Click"
                                  ToolTipService.ShowOnDisabled="True"
                                  ToolTip="Cut a detail at any scale from an AM_7 circle or rectangle"/>
                        <MenuItem x:Name="MnuUpdateDetails" Header="Update Details" Click="MnuUpdateDetails_Click"
                                  ToolTipService.ShowOnDisabled="True"
                                  ToolTip="Redraw every detail from the current 3D file"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <!-- Bản vẽ 2D (spec 2026-11-20 3d-controls-in-2d): áp sửa chờ vào 3D, vẽ lại Plan View + Detail. Chỉ hiện khi đọc nền file 3D. -->
            <Button x:Name="BtnUpdate2D" Content="Update" Style="{StaticResource ToolbarPrimaryButtonStyle}" Visibility="Collapsed"
                    Click="BtnUpdate2D_Click"
                    ToolTip="Apply the waiting edits to the 3D file, then redraw the Plan View and the details of this panel"/>
            <Button x:Name="BtnCopy" Content="Copy" Style="{StaticResource ToolbarButtonStyle}"
                    Click="BtnCopy_Click" ToolTip="Copy the table to the clipboard (paste straight into Excel)"/>
            <Button x:Name="BtnPick" Content="Pick" Style="{StaticResource ToolbarButtonStyle}"
                    Click="BtnPick_Click" ToolTip="Click objects, or drag a window on empty space (left→right = fully inside, right→left = touching), to find their rows. Shift + click / drag (or type R) = unselect, A = add again. Enter = done, Esc = clear the selection"/>
        </WrapPanel>

        <TextBlock Grid.Row="1" Style="{StaticResource HelperTextStyle}" Margin="2,2,2,6"
                   Text="Select rows like in Excel (Shift / Ctrl + click, drag, Ctrl+A) to highlight them; double-click a row to zoom. Changing Kind (Web / Closed Plate), Tripping, Collar, FB height, ⇄ or Sniped End on a selected row applies it to every selected row; the panel rebuilds automatically. Right-click for Delete / Restore; Ctrl+C copies the selection. Pick finds rows from the drawing; Esc clears the selection."/>

        <!-- ===== Row 2: Bảng kết quả ===== -->
        <DataGrid x:Name="GridResult" Grid.Row="2" Style="{StaticResource PanelDataGridStyle}"
                  RowStyle="{StaticResource ResultRowStyle}"
                  CellStyle="{StaticResource ResultCellStyle}"
                  MinRowHeight="24" RowHeaderWidth="0" CanUserResizeRows="False"
                  SelectionMode="Extended"
                  SelectionChanged="GridResult_SelectionChanged"
                  PreviewMouseLeftButtonDown="GridResult_PreviewMouseDown"
                  MouseDoubleClick="GridResult_MouseDoubleClick"
                  PreviewKeyDown="Grid_PreviewKeyDown">
            <!-- Ctrl+C: copy các dòng ĐANG CHỌN (kèm header) để dán Excel. -->
            <DataGrid.CommandBindings>
                <CommandBinding Command="ApplicationCommands.Copy" Executed="GridCopy_Executed"/>
            </DataGrid.CommandBindings>
            <DataGrid.ContextMenu>
                <ContextMenu Opened="GridMenu_Opened">
                    <MenuItem Header="Zoom to Object" Click="MnuZoomTo_Click"/>
                    <MenuItem Header="Pick in Drawing" Click="BtnPick_Click"
                              ToolTip="Click objects, or drag a window on empty space (left→right = fully inside, right→left = touching), to find their rows. Shift + click / drag (or type R) = unselect, A = add again. Enter = done, Esc = clear the selection"/>
                    <MenuItem x:Name="MnuDelete" Header="Delete" Click="MnuDelete_Click"
                              ToolTip="Remove the selected solids from the 3D block (kept across rebuilds; Restore to undo)"/>
                    <MenuItem x:Name="MnuRestore" Header="Restore" Click="MnuRestore_Click"
                              ToolTip="Bring the selected deleted solids back, then rebuild"/>
                    <MenuItem Header="Clear Correction" Click="MnuClearCorrection_Click"
                              ToolTip="Remove every correction of the selected rows (Tripping, Collar, FB height, direction, Sniped End, Kind), then rebuild"/>
                    <Separator/>
                    <MenuItem Header="Copy" Click="BtnCopy_Click"
                              ToolTip="Copy the selected rows (or the whole table when one row is selected) to the clipboard — paste straight into Excel"/>
                    <MenuItem Header="Export Table to CSV..." Click="BtnExport_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <!-- Chỉ hiện khi Build nhiều panel 1 lúc (PanelResultView.Load bật/tắt). -->
                <DataGridTextColumn x:Name="ColPanel" Header="Panel" Binding="{Binding Panel}" Width="Auto" IsReadOnly="True" Visibility="Collapsed"/>
                <DataGridTextColumn Header="Handle" Binding="{Binding Handle}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="Family" Binding="{Binding Family}" Width="Auto" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#FF005E9E"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Kind: dropdown Web / Closed Plate khi đổi được (kỹ sư 2026-11-09), còn lại chỉ đọc. -->
                <DataGridTemplateColumn Header="Kind" Width="*" MinWidth="110" SortMemberPath="Kind">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock x:Name="KindText" Text="{Binding Kind}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="KindCombo" ItemsSource="{Binding Options}" Visibility="Collapsed"
                                          SelectedValuePath="Text" DisplayMemberPath="Text"
                                          SelectedValue="{Binding Kind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource CellCombo}"
                                          PreviewKeyDown="CmbTrip_PreviewKeyDown" PreviewMouseWheel="CmbTrip_PreviewMouseWheel"
                                          ToolTip="Web or Closed Plate. With several rows selected, every selected Web / Closed Plate row changes. The panel rebuilds automatically."/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding KindEditable}" Value="True">
                                    <Setter TargetName="KindText" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="KindCombo" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Size: FB ⇒ ô số chiều cao (Enter = ghi, trống = theo tab Input) + "× t" chỉ đọc (kỹ sư 2026-11-05). -->
                <DataGridTemplateColumn Header="Size" Width="Auto" MinWidth="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock x:Name="SizeText" Text="{Binding Size}" VerticalAlignment="Center"/>
                                <StackPanel x:Name="FbSize" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBox x:Name="FbBox" Text="{Binding FbHeightText, Mode=OneWay}" Style="{StaticResource CellTextBox}"
                                             KeyDown="TxtFbHeight_KeyDown" LostFocus="TxtFbHeight_LostFocus"
                                             ToolTip="FB height in mm (thickness comes from the 2D plan). Type a number and press Enter; leave empty to use the Input tab value. Applies to all selected FB rows."/>
                                    <TextBlock Text="{Binding FbThkText}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding CanFbHeight}" Value="True">
                                    <Setter TargetName="SizeText" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="FbSize" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <!-- Chiều cao đã sửa riêng ⇒ chữ xanh như dòng có correction (checklist C3). -->
                                <DataTrigger Binding="{Binding FbHeightCorrected}" Value="True">
                                    <Setter TargetName="FbBox" Property="Foreground" Value="#FF0050C8"/>
                                    <Setter TargetName="FbBox" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Dir: ⇄ đảo bụng HP / hướng gấp Bracket / phía Tripping B — chỉ hiện ở dòng CanFlip. -->
                <DataGridTemplateColumn Header="Dir" Width="Auto" MinWidth="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding CanFlip, Converter={StaticResource BoolToVis}}">
                                <Button Content="⇄" Style="{StaticResource CellButton}" Width="24" Padding="0"
                                        ToolTip="Flip direction (HP belly / bracket fold / tripping bracket side) and rebuild"
                                        Click="BtnFlip_Click"/>
                                <TextBlock Text="{Binding DirText}" Margin="4,0,0,0" VerticalAlignment="Center"
                                           Foreground="#FF0050C8" FontStyle="Italic"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Sniped End từng đầu (HP/FB): nút XANH = đầu đó đang vát. Rê chuột ⇒ đánh dấu đầu trên bản vẽ;
                     bấm ⇒ đổi vát/không vát rồi tự rebuild. -->
                <DataGridTemplateColumn Header="Sniped End" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding CanSnip, Converter={StaticResource BoolToVis}}">
                                <ToggleButton Content="{Binding SnipLoLabel}" IsChecked="{Binding SnipLoOn, Mode=OneWay}"
                                              Tag="lo" Style="{StaticResource CellToggle}" Margin="0,0,3,0"
                                              ToolTip="Sniped End at this end (blue = sniped). Click to toggle and rebuild."
                                              Click="BtnSnip_Click" MouseEnter="BtnSnip_MouseEnter" MouseLeave="BtnSnip_MouseLeave"/>
                                <ToggleButton Content="{Binding SnipHiLabel}" IsChecked="{Binding SnipHiOn, Mode=OneWay}"
                                              Tag="hi" Style="{StaticResource CellToggle}"
                                              ToolTip="Sniped End at this end (blue = sniped). Click to toggle and rebuild."
                                              Click="BtnSnip_Click" MouseEnter="BtnSnip_MouseEnter" MouseLeave="BtnSnip_MouseLeave"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Tripping bracket theo HP (kỹ sư 2026-11-05): dropdown Auto / On / Off — chọn ⇒ rebuild 1 lần. -->
                <DataGridTemplateColumn Header="Tripping" Width="Auto" MinWidth="64">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding TripOptions}"
                                      SelectedItem="{Binding TripChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource CellCombo}" MinWidth="58"
                                      PreviewKeyDown="CmbTrip_PreviewKeyDown" PreviewMouseWheel="CmbTrip_PreviewMouseWheel"
                                      Visibility="{Binding CanTrip, Converter={StaticResource BoolToVis}}"
                                      ToolTip="Tripping bracket on this HP. Auto = by the 3 × max stiffener spacing rule; On = at every beam it passes through; Off = none. Applies to all selected HP rows. Rebuilds the panel."/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Collar Plate theo HP (kỹ sư 2026-11-05): cùng kiểu Tripping. -->
                <DataGridTemplateColumn Header="Collar" Width="Auto" MinWidth="64">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding TripOptions}"
                                      SelectedItem="{Binding CollarChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource CellCombo}" MinWidth="58"
                                      PreviewKeyDown="CmbTrip_PreviewKeyDown" PreviewMouseWheel="CmbTrip_PreviewMouseWheel"
                                      Visibility="{Binding CanTrip, Converter={StaticResource BoolToVis}}"
                                      ToolTip="Collar Plate on this HP. Auto = the 2 CO holes on each side of every web junction; On = at every CO hole of this HP; Off = none. Applies to all selected HP rows. Rebuilds the panel."/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="⌖" Style="{StaticResource CellButton}" Width="24" Padding="0" FontSize="12"
                                    ToolTip="Zoom to and highlight this object" Click="BtnZoomRow_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ===== Row 3: Trạng thái ===== -->
        <TextBlock Grid.Row="3" x:Name="TxtStatus" Style="{StaticResource StatusTextStyle}"
                   Text="No panel in this drawing. Run Build 3D on a 2D block."/>
    </Grid>
</UserControl>
