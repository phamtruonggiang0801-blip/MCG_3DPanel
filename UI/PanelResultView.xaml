<UserControl x:Class="MCG_3DPanel.UI.PanelResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFF2F2F2"
             FontSize="11">
    <!-- Tab "Result" của PaletteSet. Bố cục theo tab Fitting Table: thanh công cụ → bảng → trạng thái.
         Cột theo họ kết cấu (spec 2026-11-04): Family · Kind (dropdown) · Size · Dir (⇄) · Flags. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PanelStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Dòng có correction → chữ XANH SemiBold, như dòng user chủ động sửa bên Fitting. -->
            <Style x:Key="ResultRowStyle" TargetType="DataGridRow">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCorrected}" Value="True">
                        <Setter Property="Foreground" Value="#FF0050C8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                    <!-- Solid đã Delete: xám nghiêng (chuột phải → Restore). Đặt SAU để thắng màu xanh. -->
                    <DataTrigger Binding="{Binding Deleted}" Value="True">
                        <Setter Property="Foreground" Value="#FF9A9A9A"/>
                        <Setter Property="FontStyle" Value="Italic"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Mục dropdown Kind: mờ + tooltip khi không áp được (vd không có mốc toe GB). -->
            <Style x:Key="KindItemStyle" TargetType="ComboBoxItem">
                <Setter Property="IsEnabled" Value="{Binding Enabled}"/>
                <Setter Property="ToolTip" Value="{Binding Tooltip}"/>
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            </Style>

            <!-- ── Control TRONG Ô grid: cùng cao 20, không margin (style chung Button 26 + margin dưới 5 /
                 ComboBox 24 + margin 4 làm nút lệch cao và combo bị bóp mất mũi tên — kỹ sư 2026-11-05). ── -->
            <Style x:Key="CellButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Height" Value="20"/>
                <Setter Property="MinWidth" Value="22"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Nút bật/tắt cùng dáng CellButton; BẬT = nền xanh chữ trắng (rõ hơn ToggleButton mặc định). -->
            <Style x:Key="CellToggle" TargetType="ToggleButton">
                <Setter Property="Background" Value="#FFE1E1E1"/>
                <Setter Property="Foreground" Value="#FF111111"/>
                <Setter Property="BorderBrush" Value="#FFADADAD"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="MinWidth" Value="36"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#FF999999"/>
                        <Setter Property="Background" Value="#FFD0D0D0"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="#FF005E9E"/>
                        <Setter Property="BorderBrush" Value="#FF004C82"/>
                        <Setter Property="Foreground" Value="#FFFFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CellCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="Height" Value="20"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="4,0,2,0"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <!-- Kind chỉ đọc: chữ xám nhạt hơn để phân biệt với ô có dropdown. -->
            <Style x:Key="ReadOnlyKindText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="5,0"/>
                <Setter Property="Foreground" Value="#FF555555"/>
                <Setter Property="ToolTip" Value="This kind is fixed by the tool and cannot be changed here"/>
            </Style>

            <!-- Ô grid: nội dung căn giữa theo chiều đứng, đệm ngang đều. -->
            <Style x:Key="ResultCellStyle" TargetType="DataGridCell">
                <Setter Property="Padding" Value="3,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#FFCCE4F7"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: thanh công cụ -->
            <RowDefinition Height="Auto"/>   <!-- 1: hướng dẫn -->
            <RowDefinition Height="*" MinHeight="80"/>
            <RowDefinition Height="Auto"/>   <!-- 3: trạng thái -->
        </Grid.RowDefinitions>

        <!-- ===== Row 0: Thanh công cụ ===== -->
        <WrapPanel Grid.Row="0" Margin="1,0,1,2">
            <Button x:Name="BtnLoad3D" Content="Load 3D" Style="{StaticResource ToolbarButtonStyle}"
                    Click="BtnLoad3D_Click" ToolTip="Pick existing MCG3D_* blocks (e.g. after reopening the drawing) and list them here"/>
            <Button x:Name="BtnExport" Content="Export CSV" Style="{StaticResource ToolbarPrimaryButtonStyle}"
                    Click="BtnExport_Click" ToolTip="Export the table (incl. corrections) to a CSV file"/>
            <Button x:Name="BtnStep" Content="Export STEP" Style="{StaticResource ToolbarButtonStyle}"
                    Click="BtnStep_Click" ToolTipService.ShowOnDisabled="True"
                    ToolTip="Export each panel to its own STEP file (&lt;Panel&gt;.stp)"/>
            <Button x:Name="BtnCopy" Content="Copy" Style="{StaticResource ToolbarButtonStyle}"
                    Click="BtnCopy_Click" ToolTip="Copy the table to the clipboard (paste straight into Excel)"/>
        </WrapPanel>

        <TextBlock Grid.Row="1" Style="{StaticResource HelperTextStyle}" Margin="2,2,2,6"
                   Text="Select a row to highlight it. Change Kind or Tripping in the dropdowns, or press ⇄ / the Sniped End buttons; the panel rebuilds automatically. Right-click for Delete / Restore."/>

        <!-- ===== Row 2: Bảng kết quả ===== -->
        <DataGrid x:Name="GridResult" Grid.Row="2" Style="{StaticResource PanelDataGridStyle}"
                  RowStyle="{StaticResource ResultRowStyle}"
                  CellStyle="{StaticResource ResultCellStyle}"
                  MinRowHeight="24" RowHeaderWidth="0" CanUserResizeRows="False"
                  SelectionMode="Single"
                  SelectionChanged="GridResult_SelectionChanged">
            <DataGrid.ContextMenu>
                <ContextMenu Opened="GridMenu_Opened">
                    <MenuItem Header="Zoom to Object" Click="MnuZoomTo_Click"/>
                    <MenuItem x:Name="MnuDelete" Header="Delete" Click="MnuDelete_Click"
                              ToolTip="Remove only this solid from the 3D block (kept across rebuilds; Restore to undo)"/>
                    <MenuItem x:Name="MnuRestore" Header="Restore" Click="MnuRestore_Click"
                              ToolTip="Bring this deleted solid back, then rebuild"/>
                    <MenuItem Header="Clear Correction" Click="MnuClearCorrection_Click"
                              ToolTip="Remove the Kind and direction correction of the selected row, then rebuild"/>
                    <Separator/>
                    <MenuItem Header="Copy Table" Click="BtnCopy_Click"
                              ToolTip="Copy the table to the clipboard (paste straight into Excel)"/>
                    <MenuItem Header="Export Table to CSV..." Click="BtnExport_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <!-- Chỉ hiện khi Build nhiều panel 1 lúc (PanelResultView.Load bật/tắt). -->
                <DataGridTextColumn x:Name="ColPanel" Header="Panel" Binding="{Binding Panel}" Width="Auto" IsReadOnly="True" Visibility="Collapsed"/>
                <DataGridTextColumn Header="Handle" Binding="{Binding Handle}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="Family" Binding="{Binding Family}" Width="Auto" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#FF005E9E"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Kind: dropdown (cùng họ) khi sửa được, chữ xám khi chỉ đọc. -->
                <DataGridTemplateColumn Header="Kind" Width="*" MinWidth="110">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="ToolTip" Value="Structure kind. Rows with a dropdown can be changed; the panel rebuilds automatically."/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock x:Name="KindText" Text="{Binding Kind}" Style="{StaticResource ReadOnlyKindText}"/>
                                <ComboBox x:Name="KindCombo" ItemsSource="{Binding Options}"
                                          SelectedValuePath="Text" DisplayMemberPath="Text"
                                          SelectedValue="{Binding Kind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ItemContainerStyle="{StaticResource KindItemStyle}"
                                          Style="{StaticResource CellCombo}"
                                          ToolTip="Change the kind of this object (rebuilds the panel)"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding KindEditable}" Value="True">
                                    <Setter TargetName="KindText" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding KindEditable}" Value="False">
                                    <Setter TargetName="KindCombo" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="KindText" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="Auto" IsReadOnly="True"/>

                <!-- Dir: ⇄ đảo bụng HP / hướng gấp Bracket / phía Tripping B — chỉ hiện ở dòng CanFlip. -->
                <DataGridTemplateColumn Header="Dir" Width="Auto" MinWidth="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding CanFlip, Converter={StaticResource BoolToVis}}">
                                <Button Content="⇄" Style="{StaticResource CellButton}" Width="24" Padding="0"
                                        ToolTip="Flip direction (HP belly / bracket fold / tripping bracket side) and rebuild"
                                        Click="BtnFlip_Click"/>
                                <TextBlock Text="{Binding DirText}" Margin="4,0,0,0" VerticalAlignment="Center"
                                           Foreground="#FF0050C8" FontStyle="Italic"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Sniped End từng đầu (HP/FB): nút XANH = đầu đó đang vát. Rê chuột ⇒ đánh dấu đầu trên bản vẽ;
                     bấm ⇒ đổi vát/không vát rồi tự rebuild. -->
                <DataGridTemplateColumn Header="Sniped End" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding CanSnip, Converter={StaticResource BoolToVis}}">
                                <ToggleButton Content="{Binding SnipLoLabel}" IsChecked="{Binding SnipLoOn, Mode=OneWay}"
                                              Tag="lo" Style="{StaticResource CellToggle}" Margin="0,0,3,0"
                                              ToolTip="Sniped End at this end (blue = sniped). Click to toggle and rebuild."
                                              Click="BtnSnip_Click" MouseEnter="BtnSnip_MouseEnter" MouseLeave="BtnSnip_MouseLeave"/>
                                <ToggleButton Content="{Binding SnipHiLabel}" IsChecked="{Binding SnipHiOn, Mode=OneWay}"
                                              Tag="hi" Style="{StaticResource CellToggle}"
                                              ToolTip="Sniped End at this end (blue = sniped). Click to toggle and rebuild."
                                              Click="BtnSnip_Click" MouseEnter="BtnSnip_MouseEnter" MouseLeave="BtnSnip_MouseLeave"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Tripping bracket theo HP (kỹ sư 2026-11-05): dropdown Auto / On / Off — chọn ⇒ rebuild 1 lần. -->
                <DataGridTemplateColumn Header="Tripping" Width="Auto" MinWidth="64">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding TripOptions}"
                                      SelectedItem="{Binding TripChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource CellCombo}" MinWidth="58"
                                      Visibility="{Binding CanTrip, Converter={StaticResource BoolToVis}}"
                                      ToolTip="Tripping bracket on this HP. Auto = by the 3 × max stiffener spacing rule; On = at every beam it passes through; Off = none. Rebuilds the panel."/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="⌖" Style="{StaticResource CellButton}" Width="24" Padding="0" FontSize="12"
                                    ToolTip="Zoom to and highlight this object" Click="BtnZoomRow_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ===== Row 3: Trạng thái ===== -->
        <TextBlock Grid.Row="3" x:Name="TxtStatus" Style="{StaticResource StatusTextStyle}"
                   Text="No 3D model yet. Run Build 3D in the Input tab."/>
    </Grid>
</UserControl>
