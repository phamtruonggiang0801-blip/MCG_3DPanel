<UserControl x:Class="MCG_3DPanel.UI.PanelNamingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFF2F2F2"
             FontSize="11">
    <!-- Tab "Naming" (spec 2026-11-05): mỗi dòng = 1 tuyến Web/HP hoặc 1 thanh FB; tên tự sinh T/L/HT/HL/BS, sửa được. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PanelStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="80"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="1,0,1,2">
            <Button x:Name="BtnSelect" Content="Select panel…" Style="{StaticResource ToolbarPrimaryButtonStyle}"
                    Click="BtnSelect_Click" ToolTip="Pick one or more 2D panel blocks and name their structure (no 3D is built)"/>
            <TextBlock Text="Position" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <ComboBox x:Name="CmbPosition" Width="90" VerticalAlignment="Center" SelectedIndex="0"
                      SelectionChanged="CmbPosition_SelectionChanged"
                      ToolTip="Numbering follows the ship: T/HT from aft to fore (left → right); L/HL from the centre line to the side (Center/Port: bottom → top, Starboard: top → bottom)">
                <ComboBoxItem Content="Center"/>
                <ComboBoxItem Content="Port"/>
                <ComboBoxItem Content="Starboard"/>
            </ComboBox>
            <Button x:Name="BtnCopy" Content="Copy" Style="{StaticResource ToolbarButtonStyle}" Margin="8,0,0,0"
                    Click="BtnCopy_Click" ToolTip="Copy the table (or the selected rows) to the clipboard — paste straight into Excel"/>
        </WrapPanel>

        <TextBlock Grid.Row="1" Style="{StaticResource HelperTextStyle}" Margin="2,2,2,6"
                   Text="Names are generated by rule: Web T# / L#, HP HT# / HL#, flat bars BS. Type a name and press Enter to rename a line; with several rows selected, every selected row gets that name. Right-click → Reset to auto. Names are saved in the drawing (Ctrl+S)."/>

        <DataGrid x:Name="GridNaming" Grid.Row="2" Style="{StaticResource PanelDataGridStyle}"
                  CellStyle="{StaticResource ResultCellStyle}"
                  MinRowHeight="24" RowHeaderWidth="0" CanUserResizeRows="False"
                  SelectionMode="Extended"
                  SelectionChanged="GridNaming_SelectionChanged"
                  PreviewMouseLeftButtonDown="GridNaming_PreviewMouseDown">
            <DataGrid.CommandBindings>
                <CommandBinding Command="ApplicationCommands.Copy" Executed="GridCopy_Executed"/>
            </DataGrid.CommandBindings>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Zoom to Object" Click="MnuZoomTo_Click"/>
                    <MenuItem Header="Reset to auto" Click="MnuReset_Click"
                              ToolTip="Drop your names on the selected rows and go back to the generated names"/>
                    <Separator/>
                    <MenuItem Header="Copy" Click="BtnCopy_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColPanel" Header="Panel" Binding="{Binding Panel}" Width="Auto" IsReadOnly="True" Visibility="Collapsed"/>
                <DataGridTemplateColumn Header="Name" Width="*" MinWidth="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox x:Name="NameBox" Text="{Binding Name, Mode=OneWay}" Style="{StaticResource CellTextBox}"
                                     HorizontalAlignment="Stretch" ToolTip="{Binding NameTip}"
                                     KeyDown="TxtName_KeyDown" LostKeyboardFocus="TxtName_LostFocus"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUserName}" Value="True">
                                    <Setter TargetName="NameBox" Property="Foreground" Value="#FF0050C8"/>
                                    <Setter TargetName="NameBox" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="Dir" Binding="{Binding Dir}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="Pieces" Binding="{Binding Pieces}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="Thk" Binding="{Binding Thk}" Width="Auto" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="⌖" Style="{StaticResource CellButton}" Width="24" Padding="0" FontSize="12"
                                    ToolTip="Zoom to and highlight this line" Click="BtnZoomRow_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" x:Name="TxtStatus" Style="{StaticResource StatusTextStyle}"
                   Text="No panel yet. Click Select panel… or run Build 3D."/>
    </Grid>
</UserControl>
