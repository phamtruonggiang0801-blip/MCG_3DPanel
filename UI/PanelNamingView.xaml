<UserControl x:Class="MCG_3DPanel.UI.PanelNamingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFF2F2F2"
             FontSize="11">
    <!-- Tab "Naming" (spec 2026-11-05): mỗi dòng = 1 tuyến Web/HP hoặc 1 thanh FB; tên tự sinh T/L/HT/HL/BS, sửa được. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PanelStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="80"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="1,0,1,2">
            <!-- Kỹ sư 2026-11-05: bỏ Select panel / Copy / Position — panel nạp từ Build 3D, Position theo tab Input. -->
            <Button x:Name="BtnPick" Content="Pick" Style="{StaticResource ToolbarButtonStyle}"
                    Click="BtnPick_Click" ToolTip="Click objects, or drag a window on empty space (left→right = fully inside, right→left = touching), to find their lines. Shift + click / drag (or type R) = unselect, A = add again. Enter = done, Esc = clear the selection"/>
        </WrapPanel>

        <TextBlock Grid.Row="1" Style="{StaticResource HelperTextStyle}" Margin="2,2,2,6"
                   Text="Panels appear here after Build 3D. Names are generated by rule (numbering follows the Position on the Input tab): Web T# / L#, HP HT# / HL#, flat bars BS; Size comes from the object. Type a name and press Enter to rename a line; with several rows selected, every selected row gets that name. Double-click a row to zoom. Right-click → Zoom, Del Name, Merge / Unmerge, Reset to auto. Names are saved in the drawing (Ctrl+S)."/>

        <DataGrid x:Name="GridNaming" Grid.Row="2" Style="{StaticResource PanelDataGridStyle}"
                  CellStyle="{StaticResource ResultCellStyle}"
                  MinRowHeight="24" RowHeaderWidth="0" CanUserResizeRows="False"
                  SelectionMode="Extended"
                  SelectionChanged="GridNaming_SelectionChanged"
                  PreviewMouseLeftButtonDown="GridNaming_PreviewMouseDown"
                  MouseDoubleClick="GridNaming_MouseDoubleClick"
                  PreviewKeyDown="Grid_PreviewKeyDown">
            <DataGrid.CommandBindings>
                <CommandBinding Command="ApplicationCommands.Copy" Executed="GridCopy_Executed"/>
            </DataGrid.CommandBindings>
            <DataGrid.ContextMenu>
                <ContextMenu Opened="GridMenu_Opened">
                    <MenuItem Header="Zoom to Object" Click="MnuZoomTo_Click"/>
                    <MenuItem Header="Pick in Drawing" Click="BtnPick_Click"
                              ToolTip="Click objects, or drag a window on empty space (left→right = fully inside, right→left = touching), to find their lines. Shift + click / drag (or type R) = unselect, A = add again. Enter = done, Esc = clear the selection"/>
                    <Separator/>
                    <MenuItem Header="Del Name" Click="MnuDelName_Click"
                              ToolTip="Do not name the selected lines: they are hidden and the other lines are renumbered"/>
                    <MenuItem x:Name="MnuRestoreDeleted" Header="Restore deleted names" Click="MnuRestoreDeleted_Click"
                              ToolTip="Bring back every line removed with Del Name in the listed panels, then renumber"/>
                    <MenuItem x:Name="MnuMerge" Header="Merge" Click="MnuMerge_Click"
                              ToolTip="Combine the selected lines of the same kind and direction into one line with one name and one number; the others renumber"/>
                    <MenuItem x:Name="MnuUnmerge" Header="Unmerge" Click="MnuUnmerge_Click"/>
                    <Separator/>
                    <MenuItem Header="Reset to auto" Click="MnuReset_Click"
                              ToolTip="Drop your names and splits on the selected rows and go back to the generated names and grouping"/>
                    <Separator/>
                    <MenuItem Header="Copy" Click="BtnCopy_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColPanel" Header="Panel" Binding="{Binding Panel}" Width="Auto" IsReadOnly="True" Visibility="Collapsed"/>
                <!-- Revision 2: Name (sửa được) và Size (chỉ đọc, theo đối tượng) là 2 cột riêng. -->
                <DataGridTemplateColumn Header="Name" Width="Auto" MinWidth="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox x:Name="NameBox" Text="{Binding Name, Mode=OneWay}" Style="{StaticResource CellTextBox}" MinWidth="60"
                                     HorizontalAlignment="Stretch" ToolTip="{Binding NameTip}"
                                     KeyDown="TxtName_KeyDown" LostKeyboardFocus="TxtName_LostFocus"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUserName}" Value="True">
                                    <Setter TargetName="NameBox" Property="Foreground" Value="#FF0050C8"/>
                                    <Setter TargetName="NameBox" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Size" Binding="{Binding Spec}" Width="*" MinWidth="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Kind" Binding="{Binding KindText}" Width="Auto" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" x:Name="TxtStatus" Style="{StaticResource StatusTextStyle}"
                   Text="No panel yet. Run Build 3D (Input tab)."/>
    </Grid>
</UserControl>
