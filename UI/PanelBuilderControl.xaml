<UserControl x:Class="MCG_3DPanel.UI.PanelBuilderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFF5F5F5" Foreground="#FF222222"
             FontFamily="Segoe UI" FontSize="13">
    <!-- Theme SÁNG — đồng bộ với MCG_FittingManagement (Views/FittingManagement/FittingStyles.xaml):
         nền trắng/xám nhạt, primary xanh #FF005E9E, viền #FFCCCCCC/#FFADADAD. Xem CLAUDE.md. -->
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF222222"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF666666"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF666666"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF222222"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF111111"/>
            <Setter Property="BorderBrush" Value="#FFADADAD"/>
            <Setter Property="Padding" Value="5,4"/>
        </Style>

        <!-- Khung nhóm từng bước — GroupBox (idiom của repo tham khảo) thay vì Border tự vẽ. -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#FFCCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF222222"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10,6,10,10"/>
        </Style>

        <!-- Nút thường (mặc định repo tham khảo). -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFE1E1E1"/>
            <Setter Property="Foreground" Value="#FF111111"/>
            <Setter Property="BorderBrush" Value="#FFADADAD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFD0D0D0"/>
                    <Setter Property="BorderBrush" Value="#FF999999"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FFBDBDBD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Nút hành động chính (Inspect/Classify/Build/Export). -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF005E9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF004C82"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF004C82"/>
                    <Setter Property="BorderBrush" Value="#FF003A63"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF003A63"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tab header sáng màu -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#FFECECEC"/>
            <Setter Property="Foreground" Value="#FF222222"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#FFCCCCCC" BorderThickness="1,1,1,0"
                                CornerRadius="3,3,0,0" Margin="0,0,3,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF005E9E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid sáng màu (giá trị theo FittingDataGridStyle của repo tham khảo). -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF111111"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FFF7F7F7"/>
            <Setter Property="BorderBrush" Value="#FFCCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FFE8E8E8"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFF5F5F5"/>
            <Setter Property="Foreground" Value="#FF222222"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#FFCCCCCC"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF005E9E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="MCG · Build 3D Panel" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="Turn a 2D plan-view panel block into a 3D solid model."
                       Style="{StaticResource Hint}" Margin="0,2,0,0"/>
        </StackPanel>

        <TabControl x:Name="TabMain" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- ============ TAB 1: INPUT ============ -->
            <TabItem Header="Input">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>
                        <!-- Step 1 -->
                        <GroupBox Header="Step 1 — Inspect &amp; classify">
                            <StackPanel>
                                <TextBlock Text="Inspect exports every object (incl. nested blocks) to JSON. Classify detects the part types (Top Plate / Web / Flange / Flat Bar / HP / Bracket)."
                                           Style="{StaticResource Hint}"/>
                                <Button x:Name="BtnInspect" Content="Inspect Panel  →  JSON"
                                        Style="{StaticResource PrimaryBtn}" Click="BtnInspect_Click"/>

                                <TextBlock Text="Panel position (for OB/IB brackets)" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="CmbPanelPos" SelectedIndex="0"
                                          Background="White" Foreground="#FF111111" Padding="4,3">
                                    <ComboBoxItem Content="Center"/>
                                    <ComboBoxItem Content="Port Side"/>
                                    <ComboBoxItem Content="Starboard Side"/>
                                </ComboBox>

                                <Button x:Name="BtnClassify" Content="Classify Panel  →  Result grid"
                                        Style="{StaticResource PrimaryBtn}" Click="BtnClassify_Click"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Step 2 -->
                        <GroupBox Header="Step 2 — Build parameters (mm)">
                            <StackPanel>
                                <TextBlock Text="Top Plate — thickness" Style="{StaticResource Label}"/>
                                <TextBox x:Name="TxtTopPlateThk" Text="6"/>

                                <TextBlock Text="Web — height (H)" Style="{StaticResource Label}"/>
                                <TextBox x:Name="TxtWebHeight" Text="374"/>

                                <TextBlock Text="Flange — thickness" Style="{StaticResource Label}"/>
                                <TextBox x:Name="TxtFlangeThk" Text="20"/>

                                <TextBlock Text="Flat Bar — spec (height*thickness, e.g. 120*6)" Style="{StaticResource Label}"/>
                                <TextBox x:Name="TxtFlatBarSpec" Text="120*6"/>

                                <TextBlock Text="HP — spec (height*thickness, e.g. 120*6)" Style="{StaticResource Label}"/>
                                <TextBox x:Name="TxtHpSpec" Text="120*6"/>

                                <Button x:Name="BtnBuild" Content="Build 3D  →  preview"
                                        Style="{StaticResource PrimaryBtn}" Click="BtnBuild_Click"/>
                                <TextBlock Text="Pick the panel, then choose Yes/No at the command line to keep or discard the 3D model."
                                           Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ TAB 2: RESULT ============ -->
            <TabItem Header="Result">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Click a row to highlight &amp; zoom the object in the drawing. Edit the last column to correct a wrong type, then Export."
                               Style="{StaticResource Hint}" Margin="0,0,0,6"/>

                    <DataGrid x:Name="GridResult" Grid.Row="1"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" HeadersVisibility="Column"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal"
                              SelectionChanged="GridResult_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Handle" Binding="{Binding Handle}"
                                                IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="Type (detected)" Binding="{Binding DetectedType}"
                                                IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Correct type" Binding="{Binding CorrectedType}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Thanh cố định: info co giãn bên trái, nút Export LUÔN hiện bên phải -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="TxtGridInfo" Text="No classification yet."
                                   Style="{StaticResource Hint}" VerticalAlignment="Center"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" x:Name="BtnExport" Content="Export grid  →  CSV"
                                Style="{StaticResource PrimaryBtn}" Margin="0" MinWidth="150"
                                Click="BtnExport_Click"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#FFF5F5F5" BorderBrush="#FFCCCCCC" BorderThickness="1"
                CornerRadius="3" Padding="8,6" Margin="0,4,0,0">
            <TextBlock x:Name="TxtStatus" Text="Ready." TextWrapping="Wrap" FontStyle="Italic" Foreground="#FF2E7D32"/>
        </Border>
    </Grid>
</UserControl>
