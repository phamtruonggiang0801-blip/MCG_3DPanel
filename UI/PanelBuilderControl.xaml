<UserControl x:Class="MCG_3DPanel.UI.PanelBuilderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF2B2B2B" Foreground="#FFEAEAEA"
             FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFEAEAEA"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFC9C9C9"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9A9A9A"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFEAEAEA"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF1E1E1E"/>
            <Setter Property="Foreground" Value="#FFEAEAEA"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="5,4"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FF333333"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#FF3C6EB4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="MCG · Build 3D Panel" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="Turn a 2D plan-view panel block into a 3D solid model."
                       Style="{StaticResource Hint}" Margin="0,2,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Step 1 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Step 1 — Inspect &amp; classify" Style="{StaticResource StepTitle}"/>
                        <TextBlock Text="Inspect exports every object (incl. nested blocks) to JSON. Classify detects the part types (Top Plate / Web / Flange / Flat Bar / HP / Bracket)."
                                   Style="{StaticResource Hint}"/>
                        <Button x:Name="BtnInspect" Content="Inspect Panel  →  JSON"
                                Style="{StaticResource PrimaryBtn}" Click="BtnInspect_Click"/>

                        <TextBlock Text="Panel position (for OB/IB brackets)" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="CmbPanelPos" SelectedIndex="0"
                                  Background="#FF1E1E1E" Foreground="Black" Padding="4,3">
                            <ComboBoxItem Content="Center"/>
                            <ComboBoxItem Content="Port Side"/>
                            <ComboBoxItem Content="Starboard Side"/>
                        </ComboBox>

                        <Button x:Name="BtnClassify" Content="Classify Panel  →  report"
                                Style="{StaticResource PrimaryBtn}" Click="BtnClassify_Click"/>
                    </StackPanel>
                </Border>

                <!-- Step 2 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Step 2 — Build parameters (mm)" Style="{StaticResource StepTitle}"/>

                        <TextBlock Text="Top Plate — thickness" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TxtTopPlateThk" Text="6"/>

                        <TextBlock Text="Web — height (H)" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TxtWebHeight" Text="374"/>

                        <TextBlock Text="Flange — thickness" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TxtFlangeThk" Text="20"/>

                        <TextBlock Text="Flat Bar — spec (height*thickness, e.g. 120*6)" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TxtFlatBarSpec" Text="120*6"/>

                        <TextBlock Text="HP — spec (height*thickness, e.g. 120*6)" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TxtHpSpec" Text="120*6"/>

                        <Button x:Name="BtnBuild" Content="Build 3D  →  preview"
                                Style="{StaticResource PrimaryBtn}" Click="BtnBuild_Click"/>
                        <TextBlock Text="Pick the panel, then choose Yes/No at the command line to keep or discard the 3D model."
                                   Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#FF1E1E1E" CornerRadius="3" Padding="8,6" Margin="0,4,0,0">
            <TextBlock x:Name="TxtStatus" Text="Ready." TextWrapping="Wrap" Foreground="#FF8FD18F"/>
        </Border>
    </Grid>
</UserControl>
