<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit test cho phần THUẦN C# của plugin (không phụ thuộc AutoCAD — acdbmgd không nạp được ngoài AutoCAD).
       Chỉ link các file thuần vào đây. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\UI\ResultCatalog.cs" Link="ResultCatalog.cs" />
    <Compile Include="..\..\Services\Corrections\PartCorrection.cs" Link="PartCorrection.cs" />
    <Compile Include="..\..\Services\Corrections\CorrectionJson.cs" Link="CorrectionJson.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
